{
  "name": "webweaver",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first web automation recorder and generator.",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @webweaver/extension build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/chrome": "0.3.4",
    "@types/node": "22.19.7",
    "@webweaver/core": "workspace:*",
    "@webweaver/workflow-schema": "workspace:*",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.9"
  }
}
